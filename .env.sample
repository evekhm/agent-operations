# =================================================================================
# 1. CORE DATA SOURCE TARGETS
# The BQ Analytics Plugin outputs telemetry into a specific project, dataset, and table.
# These variables tell the Observability Agent exactly where to find the data to analyze.
# =================================================================================
PROJECT_ID="<YOUR_PROJECT_ID>"                     # The GCP Project where the BigQuery analytics data resides.
DATASET_ID="<YOUR_DATASET_ID>"                     # The BigQuery dataset (e.g. logging) containing the event tables.
DATASET_LOCATION="<YOUR_DATASET_LOCATION>"         # The GCP geographic region of the dataset (e.g., us-central1).
TABLE_ID="<YOUR_TABLE_ID>"                       # The specific BigQuery table generated by the ADK Plugin (e.g. agent_events_demo).

# =================================================================================
# 2. OBSERVABILITY AGENT EXECUTION CONFIGURATION
# The Observability Agent itself needs a place to run and a model to use.
# It can operate in a separate project from the data it is analyzing.
# =================================================================================
AGENT_PROJECT_ID="${PROJECT_ID}"         # GCP Project for the Observability Agent execution environment.
AGENT_LOCATION="global"                  # Location for Agent execution.
AGENT_MODEL_ID="gemini-3.1-pro-preview"  # The specific LLM model used for the analyst sub-agents (e.g. root cause generation).
AGENT_NAME="observability_analyst"       # Name of the root agent in ADK.

# =================================================================================
# 3. AGENT'S OWN TELEMETRY (META-OBSERVABILITY)
# The Observability Agent logs its OWN execution into BigQuery.
# It is best practice to store this in a separate table from the application data.
# =================================================================================
AGENT_DATASET_ID="${DATASET_ID}"         # Output dataset for the analyst's telemetry (reusing the main dataset is fine).
AGENT_DATASET_LOCATION="${DATASET_LOCATION}" # Region for meta-observability dataset.
AGENT_TABLE_ID="observability_agent_events_v1" # Target table for the analyst's telemetry.
GOOGLE_GENAI_USE_VERTEXAI=TRUE           # Force the use of Vertex AI for Vertex Gemini integrations.

# =================================================================================
# 4. TEST APP FOR DATA GENERATION (OPTIONAL)
# These variables are only used if you run ./generate_data.sh to simulate load.
# =================================================================================
TEST_PROJECT_ID="${PROJECT_ID}"          # Project ID for the dummy app simulation.
TEST_AGENT_LOCATION="us-central1"        # Region for the dummy agent execution.
TEST_BQ_LOCATION="${DATASET_LOCATION}"   # Region for the dummy app BQ logging.
TEST_DATASET_ID="${DATASET_ID}"          # Target dataset for dummy logs.
TEST_TABLE_ID="${TABLE_ID}"              # Target table for dummy logs.
TEST_DATASTORE_ID="observability-docs"   # Test Vector DB collection for RAG simulation.
TEST_DATASTORE_LOCATION="global"         # Region for the Test Vector DB.
TEST_WEB_DATASTORE_ID="adk-web-docs"     # Alternate generic Test Vector DB collection.
TEST_AGENT_MODEL_ID="gemini-2.5-pro"     # Model used by the dummy application.

# =================================================================================
# 5. OPEN TELEMETRY
# Standard OpenTelemetry configurations used natively by ADK.
# =================================================================================
OTEL_SERVICE_NAME=adk-otel-agent
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# =================================================================================
# 6. INTERNAL BIGQUERY VIEW DEFINITIONS
# The agent automatically creates normalized views on top of the raw TABLE_ID.
# Do not change these unless you need to avoid naming collisions in your dataset.
# =================================================================================
AGENT_EVENTS_VIEW_ID="agent_events_view"
LLM_EVENTS_VIEW_ID="llm_events_view"
TOOL_EVENTS_VIEW_ID="tool_events_view"

# =================================================================================
# 7. PERFORMANCE CONSTANTS
# Advanced performance tuning for the report generation swarms.
# =================================================================================
CACHE_TTL="3600"                         # BigQuery cache TTL. Rounds "now" to block identical queries and reduce latency.
LOG_LEVEL="INFO"                         # Log level
RCA_MAX_CONCURRENT_REQUESTS="10"         # How many parallel LLMs can run during root cause analysis.
INVOCATION_TIMEOUT_MINUTES=5             # If an agent runs longer than this, it is considered a PENDING/Timeout crash.
MAX_RAW_RECORDS_LIMIT=10000000           # Safeguard maximum records pulled into memory.
RCA_PAYLOAD_TRUNCATION_LIMIT="1000"      # Safeguard: Truncates massive text payloads before generation to prevent Vertex API quota exhaustion.

# =================================================================================
# 8. KNOWLEDGE SUPERVISOR & A2A
# =================================================================================
# PTO_AGENT_URL="<URL_OF_DEPLOYED_PTO_AGENT>"
SUPERVISOR_MODEL_ID="gemini-2.5-pro"
PTO_AGENT_SERVICE_NAME="ptoagent"
PTO_AGENT_LOCATION="us-central1"
